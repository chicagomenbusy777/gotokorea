// Copy this file to firebase-config.js (same folder) and fill in your own
// Firebase project's web app config: Firebase console → Project settings →
// General → "Your apps" → SDK setup and configuration.
//
// firebase-config.js is listed in .gitignore — never commit real keys to
// this repo, since it is public. See SETUP.md for the full walkthrough.
window.FIREBASE_CONFIG = {
  apiKey: "YOUR_API_KEY",
  authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
  projectId: "YOUR_PROJECT_ID",
  storageBucket: "YOUR_PROJECT_ID.appspot.com",
  messagingSenderId: "YOUR_SENDER_ID",
  appId: "YOUR_APP_ID"
};
