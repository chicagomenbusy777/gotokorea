rules_version = '2';
// GotoKorea Firestore security rules — v1.
//
// Admin: chicagomenbusy@gmail.com (only the EMAIL lives here — Firebase
// Auth stores the password itself, hashed, on Google's servers; it is
// never written into this file, the app's code, or the repo).
//
// NOTE on rate limiting: true server-enforced rate limiting beyond what's
// implemented below (comment cooldown, vote/post gates) would need Cloud
// Functions / App Check, not available on the free Spark plan. See the
// per-feature notes below for what is and isn't tamper-proof.
//
// NOTE on userStats: postCount/reportCount/suspended only change through
// the app's own code paths, and nothing here cryptographically proves a
// given write came from a real post/report/violation — a technically
// sophisticated user calling the Firestore API directly (bypassing the
// app's JS) could skip the "honest" side-effect writes. The content
// filter below (hasBannedContent) is the one part of this that IS fully
// server-enforced and can't be bypassed that way. Good enough for v1's
// threat model (casual abuse, not a determined attacker); real
// tamper-proofing needs Cloud Functions triggers.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "chicagomenbusy@gmail.com";
    }

    function withinLength(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // Blocks obvious adult/gambling-site links or keywords in post/comment
    // bodies. Deliberately small and high-confidence here (server-enforced,
    // can't be bypassed) — the fuller, more aggressive blocklist lives
    // client-side in spam-filter.js where it's easier to iterate on without
    // risking a rules syntax mistake blocking all posting.
    function hasBannedContent(text) {
      return text.matches('(?i).*(porn|xxx\\.|adult-|casino|bet365|카지노|도박|토토|먹튀|배팅|베팅|성인광고|야동).*');
    }

    function statsOf(uid) {
      return get(/databases/$(database)/documents/userStats/$(uid)).data;
    }

    function hasStats(uid) {
      return exists(/databases/$(database)/documents/userStats/$(uid));
    }

    function postCountOf(uid) {
      return hasStats(uid) ? statsOf(uid).postCount : 0;
    }

    function reportCountOf(uid) {
      return hasStats(uid) ? statsOf(uid).reportCount : 0;
    }

    function isSuspended(uid) {
      return hasStats(uid) && statsOf(uid).get('suspended', false) == true;
    }

    function notBanned(uid) {
      return reportCountOf(uid) < 5 && !isSuspended(uid);
    }

    function canCommentOnTarget(uid, targetId) {
      return !exists(/databases/$(database)/documents/commentCooldowns/$(uid)/posts/$(targetId))
        || request.time > get(/databases/$(database)/documents/commentCooldowns/$(uid)/posts/$(targetId)).data.lastCommentAt + duration.value(30, 'm');
    }

    // ---------- Per-user stats: post count (vote gate), report count and
    // suspended flag (posting ban). One doc per uid. ----------
    match /userStats/{uid} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.postCount == 1
        && request.resource.data.reportCount == 0;
      allow update: if isSignedIn() && (
        // Self, via the post-creation path: postCount +1 only.
        (request.auth.uid == uid
          && request.resource.data.postCount == resource.data.postCount + 1
          && request.resource.data.reportCount == resource.data.reportCount)
        ||
        // Anyone else, via the report button: reportCount +1 only.
        (request.auth.uid != uid
          && request.resource.data.reportCount == resource.data.reportCount + 1
          && request.resource.data.postCount == resource.data.postCount)
        ||
        // Self, after attempting to post a banned link: flip suspended only.
        (request.auth.uid == uid
          && request.resource.data.suspended == true
          && request.resource.data.postCount == resource.data.postCount
          && request.resource.data.reportCount == resource.data.reportCount)
      );
      allow delete: if false;
    }

    // ---------- Per-user, per-thread comment cooldown (30 min) ----------
    match /commentCooldowns/{uid}/posts/{targetId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.lastCommentAt == request.time;
    }

    // ---------- Posts (자유게시판 + 시사/정치 + CCP corner) ----------
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && notBanned(request.auth.uid)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.category in ['free', 'issues', 'ccp']
        && withinLength(request.resource.data.title, 120)
        && withinLength(request.resource.data.body, 5000)
        && withinLength(request.resource.data.authorNickname, 30)
        && !hasBannedContent(request.resource.data.title)
        && !hasBannedContent(request.resource.data.body)
        && request.resource.data.createdAt == request.time;
      // No in-app edit/delete in v1 — moderation happens in the Firebase console.
      allow update, delete: if false;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && notBanned(request.auth.uid)
          && canCommentOnTarget(request.auth.uid, postId)
          && request.resource.data.authorUid == request.auth.uid
          && withinLength(request.resource.data.body, 1000)
          && withinLength(request.resource.data.authorNickname, 30)
          && !hasBannedContent(request.resource.data.body)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- Reports (report button — owner-only reading via console) ----------
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && withinLength(request.resource.data.targetAuthorUid, 128)
        && withinLength(request.resource.data.reason, 500);
      allow update, delete: if false;
    }

    // ---------- Polls (curated in-app by the one admin account) ----------
    match /polls/{pollId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /votes/{voteId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && voteId == request.resource.data.pollId + '_' + request.auth.uid
        && (isAdmin() || postCountOf(request.auth.uid) >= 10);
      allow update, delete: if false;
    }

    // ---------- Petitions ----------
    match /petitions/{petitionId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && withinLength(request.resource.data.title, 120)
        && withinLength(request.resource.data.description, 3000)
        && request.resource.data.goal is number
        && request.resource.data.goal > 0
        && !hasBannedContent(request.resource.data.title)
        && !hasBannedContent(request.resource.data.description)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /signatures/{uid} {
        // Signature count is computed client-side from this subcollection's
        // size — no denormalized counter to keep in sync.
        allow read: if true;
        allow create: if isSignedIn() && uid == request.auth.uid;
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && canCommentOnTarget(request.auth.uid, petitionId)
          && request.resource.data.authorUid == request.auth.uid
          && withinLength(request.resource.data.body, 1000)
          && withinLength(request.resource.data.authorNickname, 30)
          && !hasBannedContent(request.resource.data.body)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
